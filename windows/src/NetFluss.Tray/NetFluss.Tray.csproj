<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Notification-area meter rendering. Kept free of WPF so the headless preview tool
    (and CI) can render contact sheets without a desktop session.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>NetFluss.Tray</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- The preview tool annotates each contact-sheet cell with the row plan the renderer
         chose, and the tests assert on glyph geometry. Both need the internals. -->
    <InternalsVisibleTo Include="NetFluss.TrayPreview" />
    <InternalsVisibleTo Include="NetFluss.Tray.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../NetFluss.Core/NetFluss.Core.csproj" />
  </ItemGroup>

</Project>
