<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Notification-area meter rendering. Kept free of WPF so the headless preview tool
    (and CI) can render contact sheets without a desktop session.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>NetFluss.Tray</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../NetFluss.Core/NetFluss.Core.csproj" />
  </ItemGroup>

</Project>
