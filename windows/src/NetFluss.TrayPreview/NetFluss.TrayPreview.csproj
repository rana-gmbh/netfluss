<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless contact-sheet generator. CI runs this on windows-latest and uploads the PNG,
    which is how the tray-legibility question gets answered without a Windows machine.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>NetFluss.TrayPreview</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../NetFluss.Tray/NetFluss.Tray.csproj" />
  </ItemGroup>

</Project>
