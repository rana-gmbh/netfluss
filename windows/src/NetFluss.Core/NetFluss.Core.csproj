<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Platform-neutral layer: models, formatters, themes, localization, settings.
    Deliberately targets plain net10.0 (not net10.0-windows) so it builds and is
    unit-testable on macOS/Linux CI as well as Windows.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NetFluss.Core</RootNamespace>
  </PropertyGroup>

</Project>
