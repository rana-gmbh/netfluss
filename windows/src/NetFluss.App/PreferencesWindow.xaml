<Window x:Class="NetFluss.App.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetFluss Preferences"
        Width="720"
        Height="760"
        MinWidth="560"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!--
        Hand-styled rather than pulled from WPF-UI. The port plan names WPF-UI for the full
        Phase 1 UI, but Preferences needs four control types and a card, and a dependency
        that ships its own theming would have to be reconciled with the NetFluss themes
        anyway. These styles follow the Windows 11 Settings metrics: 4 px card radius,
        16/12 padding, 40 px switch, secondary text at 12 px.
    -->
    <Window.Resources>
        <FontFamily x:Key="UIFont">Segoe UI Variable Text, Segoe UI</FontFamily>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="2,20,0,8" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="RowSubtitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinWidth" Value="170" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
            Windows 11 toggle switch. WPF has no native one; a CheckBox would read as a
            web form rather than as Settings, and this is the control users look for.
        -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="40" Height="20" Background="Transparent">
                            <Border x:Name="Track"
                                    CornerRadius="10"
                                    Background="{DynamicResource SwitchOffBrush}"
                                    BorderBrush="{DynamicResource SwitchBorderBrush}"
                                    BorderThickness="1" />
                            <Ellipse x:Name="Knob"
                                     Width="12"
                                     Height="12"
                                     HorizontalAlignment="Left"
                                     Margin="4,0,0,0"
                                     Fill="{DynamicResource SwitchKnobBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource SwitchKnobOnBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Knob" Property="Width" Value="14" />
                                <Setter TargetName="Knob" Property="Height" Value="14" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Preferences"
                   FontFamily="{StaticResource UIFont}"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}"
                   Margin="28,20,28,0" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,0,28,24">
            <StackPanel>

                <!-- ============================ Placement ============================ -->
                <TextBlock Text="Where to show it" Style="{StaticResource SectionHeader}" />

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Meter location" Style="{StaticResource RowTitle}" />
                            <TextBlock x:Name="SurfaceCaption" Style="{StaticResource RowSubtitle}" />
                        </StackPanel>
                        <ComboBox x:Name="SurfaceBox" Grid.Column="1" />
                    </Grid>
                </Border>

                <!-- Only shown when the overlay asked for the taskbar and could not have it. -->
                <Border x:Name="FallbackNotice"
                        Style="{StaticResource Card}"
                        Visibility="Collapsed"
                        Background="{DynamicResource NoticeBrush}">
                    <StackPanel>
                        <TextBlock Text="Showing in the notification area instead"
                                   Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowSubtitle}"
                                   Text="NetFluss could not find room on the taskbar, so the meter fell back to the notification area. It will move back on its own if the taskbar becomes available." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Taskbar and widget layout" Style="{StaticResource RowTitle}" />
                            <TextBlock Style="{StaticResource RowSubtitle}"
                                       Text="One line has room for full units; stacked matches the notification area." />
                        </StackPanel>
                        <ComboBox x:Name="ReadoutStyleBox" Grid.Column="1" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Text size" Style="{StaticResource RowTitle}" />
                            <TextBlock Style="{StaticResource RowSubtitle}"
                                       Text="Applies to the taskbar meter and the floating widget." />
                        </StackPanel>
                        <ComboBox x:Name="ReadoutSizeBox" Grid.Column="1" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Hide the notification area icon" Style="{StaticResource RowTitle}" />
                            <TextBlock x:Name="HideTrayCaption" Style="{StaticResource RowSubtitle}" />
                        </StackPanel>
                        <CheckBox x:Name="HideTrayToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Floating widget" Style="{StaticResource RowTitle}" />
                            <TextBlock Style="{StaticResource RowSubtitle}"
                                       Text="An always-on-top panel you can drag anywhere. Works alongside the other placements, and depends on nothing that a Windows update can move." />
                        </StackPanel>
                        <CheckBox x:Name="WidgetToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" />
                    </Grid>
                </Border>

                <!-- ============================ Meter ============================ -->
                <TextBlock Text="Notification area" Style="{StaticResource SectionHeader}" />

                <!--
                    Live preview. Windows tray icons are 16 px at 100% DPI, which is the
                    whole difficulty of this port, so Preferences shows the real renderer
                    output at every scaling rather than describing the choice in words.
                -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Preview" Style="{StaticResource RowTitle}" />
                        <TextBlock x:Name="PreviewCaption"
                                   Style="{StaticResource RowSubtitle}"
                                   Text="Your taskbar, at each display scaling." />
                        <ItemsControl x:Name="PreviewStrip" Margin="0,12,0,2">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!--
                                        Fixed-height swatch row with the icons bottom-aligned:
                                        the four sizes differ by 16 px, so without this the
                                        captions sit at four different heights and the strip
                                        reads as broken rather than as a scale comparison.
                                    -->
                                    <StackPanel Margin="0,0,20,0" VerticalAlignment="Bottom">
                                        <Grid Height="52">
                                            <Border Background="{Binding Swatch}"
                                                    CornerRadius="3"
                                                    Padding="8"
                                                    VerticalAlignment="Bottom"
                                                    HorizontalAlignment="Center">
                                                <Image Source="{Binding Image}"
                                                       Width="{Binding Size}"
                                                       Height="{Binding Size}"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                       SnapsToDevicePixels="True" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Caption}"
                                                   Style="{StaticResource RowSubtitle}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Meter style" Style="{StaticResource RowTitle}" />
                            <TextBlock Style="{StaticResource RowSubtitle}"
                                       Text="A single line gets the full icon height, which is sharper at 100% scaling." />
                        </StackPanel>
                        <ComboBox x:Name="MeterStyleBox" Grid.Column="1" />
                    </Grid>
                </Border>

                <!-- Only meaningful for the Icon meter style; disabled otherwise. -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock x:Name="GlyphTitle" Text="Icon" Style="{StaticResource RowTitle}" />
                            <TextBlock Style="{StaticResource RowSubtitle}"
                                       Text="Used when the meter style is set to Icon only. Drawn to fit whatever size your display asks for." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Image x:Name="GlyphPreview" Width="24" Height="24" Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <ComboBox x:Name="GlyphBox" MinWidth="150" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Units" Style="{StaticResource RowTitle}" />
                            <TextBlock Style="{StaticResource RowSubtitle}"
                                       Text="Bytes per second, or bits as ISPs quote them." />
                        </StackPanel>
                        <ComboBox x:Name="UnitsBox" Grid.Column="1" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Show direction arrows" Style="{StaticResource RowTitle}" />
                            <TextBlock Style="{StaticResource RowSubtitle}"
                                       Text="Costs width the digits need below 24 px. The row colour already shows direction." />
                        </StackPanel>
                        <CheckBox x:Name="ArrowsToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Keep colours readable" Style="{StaticResource RowTitle}" />
                            <TextBlock x:Name="ContrastCaption" Style="{StaticResource RowSubtitle}" />
                        </StackPanel>
                        <CheckBox x:Name="ContrastToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" />
                    </Grid>
                </Border>

                <!-- ============================ Colours ============================ -->
                <TextBlock Text="Colours" Style="{StaticResource SectionHeader}" />

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Download" Style="{StaticResource RowTitle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border x:Name="DownloadSwatch" Width="20" Height="20" CornerRadius="10"
                                    Margin="0,0,10,0" VerticalAlignment="Center"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" />
                            <ComboBox x:Name="DownloadAccentBox" MinWidth="150" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Upload" Style="{StaticResource RowTitle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border x:Name="UploadSwatch" Width="20" Height="20" CornerRadius="10"
                                    Margin="0,0,10,0" VerticalAlignment="Center"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" />
                            <ComboBox x:Name="UploadAccentBox" MinWidth="150" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================ General ============================ -->
                <TextBlock Text="General" Style="{StaticResource SectionHeader}" />

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Update frequency" Style="{StaticResource RowTitle}" />
                            <TextBlock Style="{StaticResource RowSubtitle}"
                                       Text="Longer intervals use less battery on an idle machine." />
                        </StackPanel>
                        <ComboBox x:Name="IntervalBox" Grid.Column="1" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}" />
                            <TextBlock x:Name="LaunchCaption" Style="{StaticResource RowSubtitle}" />
                        </StackPanel>
                        <CheckBox x:Name="LaunchToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Language" Style="{StaticResource RowTitle}" />
                            <TextBlock Style="{StaticResource RowSubtitle}"
                                       Text="Shared with the macOS app — one set of translations for both." />
                        </StackPanel>
                        <ComboBox x:Name="LanguageBox" Grid.Column="1" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Theme" Style="{StaticResource RowTitle}" />
                            <TextBlock Style="{StaticResource RowSubtitle}"
                                       Text="Sets the popover, the widget and the rate colours. A colour set above to anything but Automatic keeps that colour." />
                        </StackPanel>
                        <ComboBox x:Name="ThemeBox" Grid.Column="1" />
                    </Grid>
                </Border>

                <TextBlock x:Name="FooterText"
                           Style="{StaticResource RowSubtitle}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
