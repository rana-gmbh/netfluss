<Window x:Class="NetFluss.App.PopoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetFluss"
        Width="320"
        Height="460"
        MinWidth="280"
        MinHeight="220"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="8"
            Background="{DynamicResource PopoverBackgroundBrush}"
            BorderBrush="{DynamicResource PopoverBorderBrush}"
            BorderThickness="1"
            Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- Header totals, matching the macOS popover header. -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Download" Foreground="{DynamicResource PopoverSecondaryBrush}" FontSize="11" />
                    <TextBlock x:Name="DownloadText"
                               Foreground="{DynamicResource PopoverDownloadBrush}"
                               FontSize="20"
                               FontFamily="Consolas"
                               Text="—" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Upload" Foreground="{DynamicResource PopoverSecondaryBrush}" FontSize="11" />
                    <TextBlock x:Name="UploadText"
                               Foreground="{DynamicResource PopoverUploadBrush}"
                               FontSize="20"
                               FontFamily="Consolas"
                               Text="—" />
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1" Text="Adapters" Foreground="{DynamicResource PopoverSecondaryBrush}" FontSize="11" Margin="0,0,0,6" />

            <!--
                Fills whatever height the window has been dragged to. It used to be capped
                at a fixed 300, which was the right call while the window could not be
                resized and is the wrong one now that it can — a resized popover would have
                grown a band of empty background under a still-scrolling list.
            -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="AdapterList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource PopoverCardBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource PopoverTextBrush}" FontSize="13" />
                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="{DynamicResource PopoverSecondaryBrush}"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Foreground="{DynamicResource PopoverDownloadBrush}" FontSize="11" FontFamily="Consolas"
                                                   Text="{Binding RxRateBps, StringFormat={}↓ {0:N0} B/s}" />
                                        <TextBlock Foreground="{DynamicResource PopoverUploadBrush}" FontSize="11" FontFamily="Consolas"
                                                   Text="{Binding TxRateBps, StringFormat={}↑ {0:N0} B/s}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
