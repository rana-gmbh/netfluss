<Window x:Class="NetFluss.App.PopoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetFluss"
        Width="320"
        SizeToContent="Height"
        MaxHeight="560"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="8"
            Background="#F2202020"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="14">
        <StackPanel>
            <!-- Header totals, matching the macOS popover header. -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Download" Foreground="#99FFFFFF" FontSize="11" />
                    <TextBlock x:Name="DownloadText"
                               Foreground="#4CC2FF"
                               FontSize="20"
                               FontFamily="Consolas"
                               Text="—" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Upload" Foreground="#99FFFFFF" FontSize="11" />
                    <TextBlock x:Name="UploadText"
                               Foreground="#6CCB5F"
                               FontSize="20"
                               FontFamily="Consolas"
                               Text="—" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Adapters" Foreground="#99FFFFFF" FontSize="11" Margin="0,0,0,6" />

            <!--
                Capped like the macOS popover so many VPN/virtual interfaces cannot push
                the window past the screen edge.
            -->
            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="AdapterList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1AFFFFFF" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="13" />
                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="#80FFFFFF"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Foreground="#4CC2FF" FontSize="11" FontFamily="Consolas"
                                                   Text="{Binding RxRateBps, StringFormat={}↓ {0:N0} B/s}" />
                                        <TextBlock Foreground="#6CCB5F" FontSize="11" FontFamily="Consolas"
                                                   Text="{Binding TxRateBps, StringFormat={}↑ {0:N0} B/s}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Border>
</Window>
