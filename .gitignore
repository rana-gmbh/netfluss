.DS_Store
/.build
/Packages
xcuserdata/
DerivedData/
.swiftpm/configuration/registries.json
.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata
.netrc
*.app
mock_*.py

# Local scratch note — not for committing
SESSION-HANDOFF.md

# Build artifacts / local test outputs (root-level only).
# Note: the project legitimately tracks Screenshots/, screenshot.png, and
# Packaging/Resources/*.icns — do NOT add broad *.png/*.icns/Screenshots ignores.
/NetFluss-*.zip
/Icon.Pack.zip
/dist/
/Icon.Pack/

# Windows port (.NET) build output
windows/**/bin/
windows/**/obj/
windows/artifacts/

# The `*.app` rule above is for built macOS bundles, but git matches it
# case-insensitively on APFS, so it also swallows the whole NetFluss.App project
# directory. Re-include it explicitly — the parent directory must be un-excluded
# first, since git never descends into an excluded directory.
!windows/src/NetFluss.App/
